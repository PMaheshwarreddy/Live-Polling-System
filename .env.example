# --- Core ---
PORT=5000
DATABASE_URL=postgres://classpulse:classpulse@localhost:5432/classpulse
REDIS_URL=redis://localhost:6379
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads

# --- AI: runs 100% locally with Ollama (https://ollama.com). No API keys, no per-token costs. ---
# Set to false to run polling only, without any AI features.
AI_ENABLED=true
OLLAMA_URL=http://localhost:11434
# Quiz generation and the teaching assistant (ollama pull qwen2.5:3b)
AI_MODEL_SMART=qwen2.5:3b
# Tutor, poll insights, HyDE and CRAG steps (ollama pull qwen2.5:1.5b)
AI_MODEL_FAST=qwen2.5:1.5b
# Embeddings, 384 dimensions to match the database schema (ollama pull all-minilm)
AI_MODEL_EMBED=all-minilm
# Default retrieval strategy: vector | hybrid | hyde | crag | graph
RAG_STRATEGY=hybrid
# CPU threads per model call. 0 = let Ollama decide. On hybrid laptop CPUs (Intel P/E cores)
# Ollama often picks 2; setting 6 made prompt processing ~70% faster on an i7-1355U.
OLLAMA_NUM_THREAD=0
# AI jobs one teacher account may start per day
AI_DAILY_JOBS_PER_TEACHER=300
# Jobs processed at once. Local models are CPU-bound, so keep this at 1-2 on a laptop.
AI_WORKER_CONCURRENCY=1

# --- Web (Vite) ---
VITE_SERVER_URL=http://localhost:5000
